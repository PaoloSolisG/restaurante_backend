APP_NAME="Restaurante SaaS"
APP_ENV=production
APP_KEY=            # <-- generar con: php artisan key:generate
APP_DEBUG=false
APP_URL=https://api.TU_DOMINIO.com

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=restaurante-mysql
DB_PORT=3306
DB_DATABASE=restaurante_central
DB_USERNAME=root
DB_PASSWORD=TU_PASSWORD_SEGURA

CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_DRIVER=redis

REDIS_HOST=restaurante-redis
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=app.TU_DOMINIO.com

DEFAULT_TENANT_ID=TU_TENANT_ID

# Config facturacion
NANIVA_BASE_URL=https://fac.naniva.com/api
NANIVA_TOKEN=TU_TOKEN
SUNAT_RUC=TU_RUC
SUNAT_RAZON_SOCIAL=TU_RAZON_SOCIAL
